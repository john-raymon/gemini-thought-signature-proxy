{
  "name": "gemini-thought-signature-proxy",
  "version": "2.0.0",
  "description": "Local proxy that preserves Gemini thought_signature across OpenAI-protocol clients (Open Design, VS Code Copilot BYOK) and Google's OpenAI-compatible endpoint",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "gemini-thought-signature-proxy": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "keywords": [
    "gemini",
    "thought_signature",
    "proxy",
    "vscode",
    "copilot",
    "byok",
    "open-design",
    "vercel-ai-sdk",
    "tool-calling",
    "agent-mode",
    "400",
    "INVALID_ARGUMENT"
  ],
  "author": "john-raymon",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "tsx": "^4.19",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}

